# MongoDB Atlas free-tier connection string.
# Create a free (M0) cluster at https://www.mongodb.com/cloud/atlas
# then use its connection string here. Storage lives on Atlas, not on
# Render, so this comfortably fits Render's free-tier disk/RAM limits.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Optional: enables live news search for the Fact Check feature.
# Free tier at https://gnews.io
GNEWS_API_KEY=

# Optional: enables the AI insight/verdict for the Fact Check feature.
# Free tier at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Set to true only for local development.
FLASK_DEBUG=false
